#!/bin/sh
# Hard fork of hicder/agy-acp: this tree has no upstream and never pushes to one.
#
# Deny-by-default. The only push target is kgrizz-git/agy-acp; anything else --
# a re-added upstream remote, a fork-network sibling, a mistyped URL -- is
# refused before it leaves the machine. The older version of this hook named
# hicder/agy-acp specifically, which only helps for the mistake you thought of.
#
# Canonical copy lives in .git/hooks/pre-push, NOT here. .git/hooks is outside
# the working tree, so it keeps working on every branch. This copy is for
# reference and reinstallation:
#
#     cp .githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Bypass with `git push --no-verify` when you mean it.

set -e

remote_name="$1"
remote_url="$2"

case "$remote_url" in
*kgrizz-git/agy-acp*) exit 0 ;;
esac

echo >&2
echo "pre-push: refusing to push to '$remote_name' ($remote_url)." >&2
echo "  This is a hard fork; the only allowed push target is kgrizz-git/agy-acp." >&2
echo "  If you really mean it: git push --no-verify" >&2
echo >&2
exit 1
