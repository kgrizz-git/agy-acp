#!/bin/sh
# Hard fork of hicder/agy-acp: this tree has no upstream and never pushes to one.
#
# Deny-by-default. The only push target is kgrizz-git/agy-acp; anything else --
# a re-added upstream remote, a fork-network sibling, a mistyped URL -- is
# refused before it leaves the machine.
#
# After cloning, run once:
#     git config core.hooksPath .githooks
#
# Local quality gates (clippy + unit tests) run on every push unless
# SKIP_LOCAL_GATES=1 is set. The fork guard always runs.
#
# Bypass everything with `git push --no-verify` when you mean it.

set -e

remote_name="$1"
remote_url="$2"

case "$remote_url" in
*kgrizz-git/agy-acp*) ;;
*)
	echo >&2
	echo "pre-push: refusing to push to '$remote_name' ($remote_url)." >&2
	echo "  This is a hard fork; the only allowed push target is kgrizz-git/agy-acp." >&2
	echo "  If you really mean it: git push --no-verify" >&2
	echo >&2
	exit 1
	;;
esac

if [ "$SKIP_LOCAL_GATES" = "1" ]; then
	exit 0
fi

cargo clippy --all-targets -- -W clippy::all -D clippy::all -A clippy::cognitive_complexity -A clippy::too_many_lines
cargo test
